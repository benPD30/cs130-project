   "source": [
    "with open(\"astronauts.csv\", \"r\") as file:\n",
    "    lines = file.readlines()\n",
    "\n",
    "data = []\n",
    "for line in lines:\n",
    "    row = line.strip().replace('\"', '').split(\",\")\n",
    "    data.append(row)\n",
    "\n",
    "print(\"Columns:\", data[0])\n",
    "\n",
    "for row in data[1:]:\n",
    "    if row[5] == \"U.S.\":\n",
    "        print(row[2], \"-\", row[10])"
